# iso/packages.x86_64 — packages for the live image (spec §11.3).
# Lean on purpose: the installer fetches the real payload onto the target.
# This list only covers what the installer itself needs to run.
base
arch-install-scripts
btrfs-progs
cryptsetup
dosfstools
efibootmgr
exfatprogs
git
gptfdisk
libarchive
linux
linux-firmware
mkinitcpio
mkinitcpio-archiso
networkmanager
iwd
pacman
parted
reflector
sbctl
sudo
vim
# NOTE: no `yay` here. `yay` is an AUR package and cannot be pacman-installed,
# so listing it in packages.x86_64 would abort the ISO build ("target not
# found"). The installer bootstraps/uses an AUR helper on the *target* only when
# the user opts in; lib/pkg.sh degrades to a warning if no helper is present.
gum
syslinux
